{
  "name": "justacamera",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Just a camera. A privacy-first, fully client-side web camera app — your photos, videos, audio, and camera frames never leave your device.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://justacamera.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/sevsev9/justacameraapp.git"
  },
  "bugs": {
    "url": "https://github.com/sevsev9/justacameraapp/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test --grep @a11y",
    "test:privacy": "playwright test --grep @privacy",
    "audit:deps": "npm audit --audit-level=high",
    "validate": "npm run format:check && npm run lint && npm run type-check && npm run test:unit && npm run build"
  },
  "dependencies": {
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.60.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "^3.3.3",
    "vitest": "^4.1.8"
  }
}
